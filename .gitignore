# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skills: .agents/skills + skills-lock.json are committed (the real files);
# .claude/skills holds machine-specific absolute-path symlinks — do not commit
/.claude/

# third-party score transcriptions used only as a local cross-reference
# (MuseScore .mxl etc.) — the PD source editions in docs/source are committed,
# these are not redistributed
/docs/source/*.mxl
/docs/source/*.mscz
/docs/source/*.musicxml
